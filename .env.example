# Server-side only — NOT prefixed with VITE_ so it never reaches the client bundle.
# Used by the Vite dev proxy (vite.config.js) and the Vercel function (api/csv.js).
CSV_URL=https://onedrive.live.com/download?resid=YOUR_RESID&authkey=YOUR_AUTHKEY&format=csv

# Client-side — controls how often the browser polls /api/csv.
VITE_REFRESH_INTERVAL_MS=30000
