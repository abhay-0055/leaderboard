# Published Google Sheet CSV URL for the Referrals leaderboard.
# File → Share → Publish to web → CSV, then paste the URL here.
VITE_REFERRALS_CSV_URL=https://docs.google.com/spreadsheets/d/<SHEET_ID>/gviz/tq?tqx=out:csv&sheet=<SHEET_NAME>

# Published Google Sheet CSV URL for the Points leaderboard.
VITE_POINTS_CSV_URL=https://docs.google.com/spreadsheets/d/<SHEET_ID>/gviz/tq?tqx=out:csv&sheet=<SHEET_NAME>

# How often the browser polls each sheet (milliseconds).
VITE_REFRESH_INTERVAL_MS=30000
