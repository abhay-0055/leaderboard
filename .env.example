# Server-side only — no VITE_ prefix, never exposed to the client bundle.
# Used by the Vite dev proxy (vite.config.js) and the Vercel functions (api/referrals.js, api/points.js).
# Sheet must be shared: File → Share → Share with others → "Anyone with the link" (Viewer).
# URL format: https://docs.google.com/spreadsheets/d/<SHEET_ID>/export?format=csv&gid=<GID>
# (gid=0 for the first tab; find the gid in the sheet URL after #gid=)
REFERRALS_CSV_URL=https://docs.google.com/spreadsheets/d/<SHEET_ID>/export?format=csv&gid=0
POINTS_CSV_URL=https://docs.google.com/spreadsheets/d/<SHEET_ID>/export?format=csv&gid=0

# Client-side — controls how often the browser polls /api/referrals and /api/points.
VITE_REFRESH_INTERVAL_MS=30000
